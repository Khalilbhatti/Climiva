# Nothing secret or machine-specific goes into an image.
.env
.env.*
!.env.example

node_modules
# Uploaded files are runtime data (a mounted volume), never part of an image.
.data
.next
out
build
coverage
test-results
playwright-report
*.tsbuildinfo

# Database dumps and asset archives are a business's data; the deploy tooling and the Docker-side tests are not part of the application.
backups
*.dump
*.dump.sha256
*.assets.tar.gz
deploy
e2e-docker
playwright.config.ts
playwright.docker.config.ts

.git
.gitignore
.claude
design-reference
docs
e2e
Dockerfile
.dockerignore
docker-compose*.yml
npm-debug.log*
