# Climvia environment. Copy to `.env` and replace every placeholder.
# `.env` and `.env.local` are git-ignored: never commit real values.

# --- PostgreSQL (read by docker-compose.yml and by the db:* scripts) ---------------------------
POSTGRES_DB=climvia
# The OWNER role creates the schema, runs migrations and seeds. The running app never uses it.
POSTGRES_OWNER_USER=climvia_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-password
# The runtime role is always `climvia_app` (a fixed name: the migrations grant privileges to it).
# It is created by `npm run db:migrate` with this password, and it is subject to Row Level Security.
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-password
# Host port for the Docker container (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- Connection strings ------------------------------------------------------------------------
# Runtime: the Next.js app. Must use the restricted `climvia_app` role so Row Level Security applies.
DATABASE_URL=postgres://climvia_app:replace-with-a-different-long-random-password@localhost:5432/climvia
# Admin: migrations, seeds, drizzle-kit and test setup only. Never give this to the running app.
DATABASE_ADMIN_URL=postgres://climvia_owner:replace-with-a-long-random-password@localhost:5432/climvia
# Optional: connection pool size for the app (default 10).
# DATABASE_POOL_MAX=10

# --- Better Auth -------------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The public origin of the app, exactly as a browser reaches it (scheme + host + port, no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra origins allowed to call the auth endpoints, comma separated.
# AUTH_TRUSTED_ORIGINS=
# Optional: the reverse proxy / load balancer in front of the app (IPs or CIDR ranges, comma separated). Set this in
# production when a proxy forwards requests, so login rate limiting sees each real client instead of one shared bucket.
# AUTH_TRUSTED_PROXIES=

# --- Development seed (npm run db:seed) -------------------------------------------------------
# Password given to every seeded demo user. The seed refuses to run when NODE_ENV=production.
SEED_PASSWORD=replace-with-a-dev-only-password
