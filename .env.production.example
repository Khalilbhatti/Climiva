# Climvia PRODUCTION settings, read by docker-compose.production.yml and deploy/scripts/*.
#
#   cp .env.production.example .env.production      then replace EVERY placeholder
#   npm run config:check -- .env.production          fails with a list of what is wrong, before anything is built or started
#
# `.env.production` is git-ignored and is never copied into an image. It holds secrets: keep it out of chat, tickets and logs. On AWS (Phase 18C2) these
# values come from AWS Secrets Manager / SSM Parameter Store onto the instance; no long-lived AWS access key belongs in this file (the instance's IAM
# role supplies credentials to S3).
#
# Generate every secret/password yourself:  openssl rand -hex 24      (letters and digits only, so they sit in a connection string unescaped)

# --- PostgreSQL (the `db` container) --------------------------------------------------------------------------------------------------
POSTGRES_DB=climvia
# The OWNER role: the container's superuser, used by the migration and by backups. The running app never receives it.
POSTGRES_OWNER_USER=climvia_owner
POSTGRES_OWNER_PASSWORD=replace-with-openssl-rand-hex-24
# The restricted runtime role `climvia_app` (a fixed name: the migrations grant privileges to it). Row Level Security binds it. A different password.
POSTGRES_APP_PASSWORD=replace-with-a-different-openssl-rand-hex-24

# The two connection strings. They must say the same as the lines above (config:check compares them): host `db`, port 5432.
#   the app    -> climvia_app, with POSTGRES_APP_PASSWORD        the migration -> the owner, with POSTGRES_OWNER_PASSWORD
DATABASE_URL=postgres://climvia_app:replace-with-a-different-openssl-rand-hex-24@db:5432/climvia
DATABASE_ADMIN_URL=postgres://climvia_owner:replace-with-openssl-rand-hex-24@db:5432/climvia
# Optional: connection pool size for the app (default 10).
# DATABASE_POOL_MAX=10

# --- The application's address and the proxy ------------------------------------------------------------------------------------------
# The public origin, exactly as a browser reaches it. https only.
BETTER_AUTH_URL=https://app.example.com
# The same host, bare: the reverse proxy serves the application on it. Must equal the host of BETTER_AUTH_URL.
PUBLIC_HOST=app.example.com
# The certificate authority writes to this address about expiring certificates. A real mailbox.
ACME_EMAIL=ops@example.com
# Generate:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
# The proxy and the app share this network; the proxy is the only hop that may name a client's address. config:check requires it in the list below.
EDGE_SUBNET=172.30.0.0/24
AUTH_TRUSTED_PROXIES=172.30.0.0/24
# Extra https origins allowed to call the sign-in endpoints (comma separated). Usually none.
# AUTH_TRUSTED_ORIGINS=
# Every OTHER name this deployment answers on (besides the host above, the platform domain, localhost and IP addresses), comma separated. Any
# other multi-label Host is treated as a customer's domain.
# APP_HOSTS=
# Host ports the proxy publishes (nothing else is published). The defaults are right for a server; change them to try the stack beside other software.
# HTTP_PORT=80
# HTTPS_PORT=443
# Which file tells the proxy how to get certificates: mode.public.caddy (public ACME; the default) or mode.local.caddy (its own CA, for a local trial).
# CADDY_MODE_FILE=./deploy/caddy/mode.public.caddy

# --- Custom domains ---------------------------------------------------------------------------------------------------------------------
# The name customers are told to point their DNS at. It can never be claimed by a business, and must not be the application's own address.
CUSTOM_DOMAIN_TARGET=sites.example.com
# Always https in production.
CUSTOM_DOMAIN_URL_SCHEME=https
# The proxy asks the application "may a certificate be requested for this name?" with this secret. Generate:  openssl rand -hex 24
TLS_ASK_TOKEN=replace-with-openssl-rand-hex-24-for-the-tls-question

# --- Uploaded files (a business's logo) -------------------------------------------------------------------------------------------------
# `local` (the `assets` volume, below) or `s3` (a PRIVATE bucket, reached with the instance's IAM role). There is no default in production.
ASSET_STORAGE_DRIVER=local
ASSET_LOCAL_DIR=/data/assets
# ASSET_STORAGE_DRIVER=s3
# AWS_REGION=us-east-2
# AWS_S3_BUCKET=your-private-bucket-name

# --- Set by the deploy script, not here -------------------------------------------------------------------------------------------------
# APP_VERSION: the git commit the images are built from (shown by /health/live and /health/ready).
